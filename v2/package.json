{
  "name": "juhudmanager-v2-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "JuhudManager V2 API running on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc",
    "test": "node --experimental-test-module-mocks --test test/*.test.js",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@shtora/argon2w": "0.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
